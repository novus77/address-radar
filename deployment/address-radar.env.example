ADDRESS_RADAR_MODE=shadow
ADDRESS_RADAR_DATABASE_PATH=/var/lib/address-radar/address-radar.db
ADDRESS_RADAR_STRATEGY_VERSION=address-radar-v1
ADDRESS_RADAR_SIGNAL_THRESHOLD=0.70
ADDRESS_RADAR_MINIMUM_PURCHASE_USD=100
ADDRESS_RADAR_MINIMUM_AGGREGATE_BUY_USD=100
ADDRESS_RADAR_ALLOWED_CHAINS=solana,bsc,eth,base,robinhood,monad
ADDRESS_RADAR_POLL_INTERVAL_MS=15000
ADDRESS_RADAR_FILE_START_AT_END=true
ADDRESS_RADAR_FOMO_EVENT_LOG_PATH=/var/lib/address-radar/events/fomo-events.jsonl
ADDRESS_RADAR_ONCHAIN_EVENT_LOG_PATH=/var/lib/address-radar/events/onchain-events.jsonl
ADDRESS_RADAR_MARKET_BASE_URL=https://api.dexscreener.com
ADDRESS_RADAR_CONSOLE_HOST=127.0.0.1
ADDRESS_RADAR_CONSOLE_PORT=3214
ADDRESS_RADAR_GATEWAY_DELIVERY_ENABLED=false
ADDRESS_RADAR_GATEWAY_ENDPOINT=http://127.0.0.1:3210/api/v1/internal/address-radar/signals
ADDRESS_RADAR_GATEWAY_KEY_ID=replace-me
ADDRESS_RADAR_GATEWAY_SHARED_SECRET=replace-me
ADDRESS_RADAR_GATEWAY_DELIVERY_INTERVAL_MS=1000
ADDRESS_RADAR_GATEWAY_TIMEOUT_MS=5000
ADDRESS_RADAR_BACKUP_DIR=/var/lib/address-radar/backups
ADDRESS_RADAR_BACKUP_RETENTION_DAYS=14
ADDRESS_RADAR_BACKUP_PAGES_PER_STEP=4096
ADDRESS_RADAR_BACKUP_SLEEP_MS=1
ADDRESS_RADAR_BACKUP_TIMEOUT_SECONDS=480

# Historical candidate backfill. Keep delivery disabled until shadow acceptance passes.
DUNE_API_KEY=replace-with-rotated-production-key
DUNE_TOKEN_UNIVERSE_QUERY_ID=replace-me
DUNE_MILESTONE_CROSSINGS_QUERY_ID=replace-me
DUNE_PRE_MILESTONE_TRADES_QUERY_ID=replace-me
DUNE_HISTORICAL_START_AT=2026-08-09T16:00:00.000Z
DUNE_QUERY_TIMEOUT_MS=300000
DUNE_POLL_INTERVAL_MS=2000
DUNE_RESULT_PAGE_SIZE=1000
DUNE_DAILY_CREDIT_BUDGET=1000
