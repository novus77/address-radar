[Unit]
Description=Address Radar Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=address-radar
Group=address-radar
WorkingDirectory=/opt/address-radar/current
EnvironmentFile=/etc/address-radar/address-radar.env
ExecStart=/opt/address-radar/current/node_modules/.bin/tsx apps/scanner/src/cli.ts
Restart=on-failure
RestartSec=5
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/address-radar /var/log/address-radar

[Install]
WantedBy=multi-user.target
