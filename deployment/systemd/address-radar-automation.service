[Unit]
Description=Address Radar Durable Automation
After=network-online.target address-radar-migrate.service
Wants=network-online.target
Requires=address-radar-migrate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=address-radar
Group=address-radar
WorkingDirectory=/opt/address-radar/current
EnvironmentFile=/etc/address-radar/address-radar.env
Environment=ADDRESS_RADAR_RUNTIME_MIGRATIONS=false
ExecStart=/opt/address-radar/current/node_modules/.bin/tsx apps/automation/src/cli.ts
Restart=on-failure
SuccessExitStatus=143
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/address-radar /var/log/address-radar
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
