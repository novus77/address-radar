[Unit]
Description=Address Radar Historical Candidate Backfill
After=network-online.target address-radar-migrate.service
Wants=network-online.target
Requires=address-radar-migrate.service

[Service]
Type=simple
User=address-radar
Group=address-radar
WorkingDirectory=/opt/address-radar/current
EnvironmentFile=/etc/address-radar/address-radar.env
Environment=ADDRESS_RADAR_RUNTIME_MIGRATIONS=false
ExecStart=/opt/address-radar/current/node_modules/.bin/tsx apps/wallet-analysis/src/historical-cli.ts
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/address-radar /var/log/address-radar

[Install]
WantedBy=multi-user.target
