[Unit]
Description=Address Radar Database Migration Barrier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=address-radar
Group=address-radar
WorkingDirectory=/opt/address-radar/current
EnvironmentFile=/etc/address-radar/address-radar.env
ExecStart=/opt/address-radar/current/node_modules/.bin/tsx scripts/migrate-database.ts
RemainAfterExit=yes
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/address-radar /var/log/address-radar

[Install]
WantedBy=multi-user.target
