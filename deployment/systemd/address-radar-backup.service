[Unit]
Description=Address Radar SQLite Backup
After=address-radar-scanner.service

[Service]
Type=oneshot
User=address-radar
Group=address-radar
WorkingDirectory=/opt/address-radar/current
EnvironmentFile=/etc/address-radar/address-radar.env
ExecStartPre=+/usr/bin/systemctl stop address-radar-scanner.service address-radar-wallet-monitor.service address-radar-wallet-analysis.service
ExecStart=/opt/address-radar/current/scripts/backup-production-state.sh
ExecStopPost=+/usr/bin/systemctl start address-radar-scanner.service address-radar-wallet-monitor.service address-radar-wallet-analysis.service
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=50%
MemoryHigh=256M
MemoryMax=512M
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/address-radar /var/log/address-radar
